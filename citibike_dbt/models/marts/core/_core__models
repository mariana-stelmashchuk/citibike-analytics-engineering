version: 2

models:
  - name: dim_stations
    description: >
      One row per station, derived from trip data. Station name and coordinates
      are taken from the most recent trip event (start or end) at the station.

    columns:
      - name: station_id
        description: "Unique identifier of the station"
        data_type: string
        data_tests:
          - unique
          - not_null

      - name: station_name
        description: "Station name as of the most recent trip event at this station"
        data_type: string
        data_tests:
          - not_null

      - name: station_lat
        description: "Latitude of the station"
        data_type: float64

      - name: station_lng
        description: "Longitude of the station"
        data_type: float64

      - name: first_trip_at
        description: "Earliest trip event (start or end) at the station within the loaded data window, in UTC; not the station opening date"
        data_type: timestamp

      - name: last_trip_at
        description: "Latest trip event (start or end) at the station within the loaded data window, in UTC"
        data_type: timestamp